# --- Required: single password for the dashboard login ---
PASSWORD=ganti-dengan-password-aman

# --- Recommended: Supabase for persistent storage ---
# Create a free project at supabase.com, run supabase/schema.sql in the SQL
# Editor, then set these. Enables: web CRUD for providers, client API keys
# management, and persistent token/request logs.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi... (service_role key — server-side only!)

# --- Optional fallbacks (no database) ---
# Providers as JSON. Used directly when Supabase is NOT configured,
# or as an import source (Providers page → "Import from ENV").
PROVIDERS_JSON=[
  {
    "name": "OpenAI",
    "baseUrl": "https://api.openai.com/v1",
    "apiKeys": ["sk-aaa", "sk-bbb"],
    "models": ["gpt-4o-mini", "gpt-4o"],
    "priority": 1,
    "enabled": true
  }
]

# Fallback client API key (prefer creating keys in the dashboard instead).
ROUTER_API_KEY=
